# Mattermost
MM_URL=https://mattermost.example.com
MM_BOT_TOKEN=
MM_BOT_USERNAME=wikibot
MM_BOT_USER_ID=

# comma-separated list of mention triggers (without leading @)
BOT_TRIGGER_MENTIONS=wikibot,kb,knowledge-bot

# Outline
OUTLINE_URL=https://wiki.example.com
OUTLINE_API_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Bot behavior
CONFIRMATION_CONFIDENCE_THRESHOLD=0.85
CONFIRMATION_TTL_MINUTES=10
CLEANUP_INTERVAL_MINUTES=5

# Storage
DB_PATH=/app/data/kb-bot.db

# Logging
LOG_LEVEL=info
NODE_ENV=production
